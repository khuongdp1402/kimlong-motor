{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/images/:path*", "destination": "/images/:path*" },
    { "source": "/((?!api|images).*)", "destination": "/index.html" }
  ]
}
